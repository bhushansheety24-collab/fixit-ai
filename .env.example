# ---------------------------------------------------------------------------
# FixIt AI — environment template.
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser — never put a
# secret there.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://fixit:fixit_dev_password@localhost:5432/fixit_ai?schema=public"

# --- Auth (required) -------------------------------------------------------
# Better Auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public base URL of the app (also used by the browser auth client).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional Google OAuth -------------------------------------------------
# Both values must be set to enable "Continue with Google".
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Extra trusted auth origins (optional) ---------------------------------
# Comma-separated origins allowed to call the auth API, in addition to
# BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL. Useful for preview deployments.
# AUTH_TRUSTED_ORIGINS="https://fixit-git-branch.vercel.app"

# --- AI provider (optional) ------------------------------------------------
# When AI_API_KEY is unset the app runs in clearly-labelled MOCK mode and no
# external calls are made. Any OpenAI-compatible vision endpoint works.
# AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# --- Image storage (optional) ----------------------------------------------
# Provider order: Cloudinary -> S3-compatible bucket -> local disk.
# Without either, uploads go to ./public/uploads (dev fallback only).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""            # set for R2 / MinIO / Supabase Storage
# S3_PUBLIC_BASE_URL=""     # public CDN base URL, if different

# --- Rate limiting (optional) ----------------------------------------------
# Without REDIS_URL an in-memory sliding window is used (single instance only).
# REDIS_URL="redis://localhost:6379"

# --- Seeding (optional) ----------------------------------------------------
# If set, `npm run db:seed` creates/promotes an ADMIN account.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
# SEED_ADMIN_NAME="FixIt Admin"
