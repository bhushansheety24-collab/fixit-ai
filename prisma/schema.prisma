// FixIt AI - Prisma Schema
// PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum UserRole {
  USER
  ADMIN
}

enum ItemSeverity {
  minor
  moderate
  major
  critical
  unknown
}

enum Repairability {
  likely_repairable
  possibly_repairable
  unlikely_repairable
  not_repairable
  unknown
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RepairRequestStatus {
  PENDING
  QUOTE_PROVIDED
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SustainabilityActivityType {
  REPAIR
  REPLACE
  REUSE
  RECYCLE
}

// ---------------- Authentication (Better Auth) ----------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  analyses             ItemAnalysis[]
  conversations        TroubleshootingConversation[]
  repairRequests       RepairRequest[]
  reviews              Review[]
  sustainabilityEvents SustainabilityRecord[]

  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  sessionState          String?
  password              String? // for email/password auth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------- Core Domain ----------------

model ItemAnalysis {
  id               String         @id @default(cuid())
  userId           String
  itemName         String
  category         String
  brand            String?
  model            String?
  purchasePrice    Decimal?       @db.Decimal(12, 2)
  itemAge          Int? // months
  condition        String?
  problemDescription String
  symptoms         String?
  warrantyInfo     String?
  imageUrls        String[]       @default([])
  aiAnalysis       Json?
  aiProvider       String? // "openai-compatible" | "mock"
  severity         ItemSeverity?  @default(unknown)
  repairability    Repairability? @default(unknown)
  status           AnalysisStatus @default(PENDING)
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations       TroubleshootingConversation[]
  repairRequests      RepairRequest[]
  sustainabilityEvent SustainabilityRecord?

  @@index([userId, createdAt(sort: Desc)])
  @@index([category])
  @@map("item_analysis")
}

model TroubleshootingConversation {
  id        String   @id @default(cuid())
  userId    String
  analysisId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis ItemAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([analysisId])
  @@map("troubleshooting_conversation")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation TroubleshootingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_message")
}

model RepairProfessional {
  id               String   @id @default(cuid())
  name             String
  description      String
  specializations  String[] @default([])
  serviceArea      String?
  serviceAreaGeo   Float? // latitude, optional
  serviceAreaGeoLon Float? // longitude, optional
  startingPrice    Decimal? @db.Decimal(12, 2)
  workingHours     String?
  contactEmail     String?
  contactPhone     String?
  website          String?
  profileImageUrl  String?
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  verifiedById     String?
  isDemo           Boolean  @default(false)
  averageRating    Float    @default(0)
  reviewCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  repairRequests RepairRequest[]
  reviews        Review[]

  @@index([verified])
  @@index([serviceArea])
  @@map("repair_professional")
}

model RepairRequest {
  id            String             @id @default(cuid())
  userId        String
  analysisId    String
  professionalId String
  description   String
  requestedDate DateTime?
  quotedPrice   Decimal?           @db.Decimal(12, 2)
  status        RepairRequestStatus @default(PENDING)
  statusHistory Json? // audit trail: [{status, at, by}]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis    ItemAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  professional RepairProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  review      Review?

  @@index([userId, createdAt(sort: Desc)])
  @@index([professionalId])
  @@index([status])
  @@map("repair_request")
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  professionalId  String
  repairRequestId String?  @unique
  rating          Int
  comment         String?
  hidden          Boolean  @default(false) // moderation
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional  RepairProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  repairRequest RepairRequest?     @relation(fields: [repairRequestId], references: [id], onDelete: SetNull)

  @@index([professionalId])
  @@index([userId])
  @@map("review")
}

model SustainabilityRecord {
  id                       String                    @id @default(cuid())
  userId                   String
  analysisId               String                    @unique
  activityType             SustainabilityActivityType
  actualRepairCost         Decimal?                  @db.Decimal(12, 2)
  estimatedReplacementCost Decimal?                  @db.Decimal(12, 2)
  estimatedMoneySaved      Decimal?                  @db.Decimal(12, 2)
  estimatedWasteAvoided    Decimal?                  @db.Decimal(12, 2) // grams
  calculationMethod        String
  dataSource               String? // e.g. "category-weight-table-v1"
  createdAt                DateTime                  @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis ItemAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([activityType])
  @@map("sustainability_record")
}

// Admin audit trail for important administrative actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_log")
}

// Simple rate-limit tracking (works without Redis)
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_event")
}
